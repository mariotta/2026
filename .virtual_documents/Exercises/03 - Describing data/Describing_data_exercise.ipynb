def bootstrap_ci(data, n_bootstrap=10000, ci=95, statistic=np.mean, random_state=None):
    """
    Compute a bootstrap confidence interval for a given statistic.

    Parameters
    ----------
    data : array-like
        The original sample data.
    n_bootstrap : int
        Number of bootstrap resamples to draw.
    ci : float
        Confidence level as a percentage (e.g. 95 for a 95% CI).
    statistic : callable
        Function to apply to each resample (default: np.mean).
    random_state : int or None
        Seed for reproducibility.

    Returns
    -------
    (lower, upper) : tuple of floats
        The lower and upper bounds of the confidence interval.
    """
    rng = np.random.default_rng(random_state)
    data = np.asarray(data)
    n = len(data)

    boot_stats = np.empty(n_bootstrap)
    for i in range(n_bootstrap):
        sample = rng.choice(data, size=n, replace=True)
        boot_stats[i] = statistic(sample)

    alpha = 100 - ci
    lower = np.percentile(boot_stats, alpha / 2)
    upper = np.percentile(boot_stats, 100 - alpha / 2)

    return lower, upper





